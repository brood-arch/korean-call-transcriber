# Korean Call Transcriber
# Copy this file to .env and fill in values for your environment.

# LLM extraction API. Any OpenAI-compatible endpoint can be used.
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=example-model

# Runtime paths.
KCT_WORKSPACE=.
AUDIO_DIR=data/audio
TRANSCRIPT_DIR=output/transcripts
ENTITIES_DIR=data/entities
STATE_DIR=state
KCT_LOG_DIR=logs
KCT_STATE_DIR=state
OBSIDIAN_VAULT=output/obsidian
CHROMA_INDEX_DIR=output/transcripts/chroma_index

# Whisper / diarization settings.
WHISPERX_PYTHON=python
WHISPER_MODEL=mobiuslabsgmbh/faster-whisper-large-v3-turbo
WHISPER_COMPUTE_TYPE=float16
HF_TOKEN_FILE=
MY_NAME=Me

# Optional Windows subprocess paths.
WINDOWS_PYTHON=python

# Correction and worker logs.
CORRECTION_RULES_PATH=state/correction_rules.json
CORRECTION_LOG_PATH=state/correction_events.jsonl
TRANSCRIBE_LOG=logs/transcribe_whisperx.log
ALIGN_LOG=logs/align_whisperx.log

# Gmail integration.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Naver Mail integration.
NAVER_MAIL_ADDRESS=
NAVER_MAIL_PASSWORD=
NAVER_MAIL_HOST=imap.naver.com
NAVER_MAIL_PORT=993
NAVER_MAIL_FOLDERS=INBOX,"Sent Messages"
NAVER_MAIL_LIMIT=100
NAVER_MAIL_STATE_DIR=state/naver_mail

# Google Calendar integration.
GCAL_TOKEN_PATH=state/gcal_token.json

# Email TODO extraction.
EMAIL_TODO_STATE=state/email_todo_state.json
EMAIL_TODO_EXCLUSIONS=state/email_todo_exclusions.json

# SMS integration (placeholder).
SMS_GATEWAY_URL=
SMS_API_KEY=

# Minions job queue (PostgreSQL).
MINIONS_DB_HOST=localhost
MINIONS_DB_PORT=5432
MINIONS_DB_NAME=minions
MINIONS_DB_USER=minions
MINIONS_DB_PASS=
